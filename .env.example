# ── قاعدة البيانات (Postgres) ─────────────────────────────────────────────
# رابط الاتصال المُجمَّع (pooled) — هوّي يلي بيستعملو التطبيق وقت التشغيل.
# من Neon: Dashboard → Connection Details → خد الرابط يلي فيه "-pooler".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# رابط الاتصال المباشر — بيستعملو Prisma للـ migrations بس (PgBouncer ما
# بيدعم الـ prepared statements). نفس الرابط بلا "-pooler".
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── الجلسات ───────────────────────────────────────────────────────────────
# مفتاح توقيع كوكيز تسجيل الدخول. ولّدي واحد جديد للإنتاج:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ضع-قيمة-عشوائية-طويلة-هون"

# ── خدمة الذكاء (FastAPI) ─────────────────────────────────────────────────
# محليًا: http://localhost:8000 — على الإنتاج: رابط الخدمة على Render.
AI_SERVICE_URL="http://localhost:8000"

# ── اختياري ───────────────────────────────────────────────────────────────
# مفتاح YouTube Data API v3، بيستعملو scripts/fetch-content.ts لجلب
# الفيديوهات. إذا فاضي، بينجلب محتوى Dev.to بس.
YOUTUBE_API_KEY=""
